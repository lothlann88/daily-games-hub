# Host-side environment for docker-compose.yml. Copy to `.env` beside the
# compose file on the deployment host (deploy.sh puts that at
# /mnt/user/appdata/dailygame/app/). `.env` is gitignored — the tunnel token
# is a live credential and must never be committed.

# Belt and braces against compose deriving the project name from the directory
# (this app and grey-tide both deploy from a dir named "app").
COMPOSE_PROJECT_NAME=dailygame

# Host interface and port PocketBase binds to. 127.0.0.1 = host-only (the
# tunnel reaches it container-to-container regardless). A Tailscale IP exposes
# it to the tailnet only — how the admin UI at /_/ is reached.
#
# 8096 is this app's registered host port (App Playbook §10); grey-tide holds
# 8095 on the same host. 8090 is the *container* port and is not configurable
# here — do not copy it up into PB_PORT.
PB_BIND=127.0.0.1
PB_PORT=8096

# Live database directory on the host. NEVER inside the app dir that deploy.sh
# rsyncs. Owned by UID 8090 (the container's unprivileged user).
PB_DATA_DIR=/mnt/user/appdata/dailygame/pb_data

# Public access via Cloudflare Tunnel. Leave both unset for a private deploy.
# The token comes from Zero Trust → Networks → Tunnels; hostname routing and
# the Access policies (locking /_/ AND /api/collections/_superusers/*) live in
# that dashboard too.
COMPOSE_PROFILES=tunnel
CLOUDFLARE_TUNNEL_TOKEN=paste-tunnel-token-here
