# Local dev backend. Run it with:
#   server/.dev/pocketbase serve --http=127.0.0.1:8090 --dir server/pb_data_dev \
#     --migrationsDir server/pb_migrations --hooksDir server/pb_hooks
# In production this variable is unset and the app uses the same-origin "/".
EXPO_PUBLIC_PB_URL=http://127.0.0.1:8090
